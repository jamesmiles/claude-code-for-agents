HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".claude", "cache")
LIMITS_CACHE = os.path.join(CACHE, "cc4a-limits.json")
LIMITS_TTL = 60
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"


def sidecar_path(sid):
    return os.path.join(CACHE, "cc4a-statusline-%s.json" % sid)


def read_sidecar(sid, max_age=900):
    try:
        st = os.stat(sidecar_path(sid))
        if time.time() - st.st_mtime > max_age:
            return None, None
        with open(sidecar_path(sid)) as f:
            return json.load(f), int(time.time() - st.st_mtime)
    except Exception:
        return None, None


# ---------- oauth token ----------
def oauth_token():
    if sys.platform == "darwin":
        try:
            raw = subprocess.run(
                ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                capture_output=True, text=True, timeout=5).stdout
            tok = json.loads(raw).get("claudeAiOauth", {}).get("accessToken")
            if tok:
                return tok
        except Exception:
            pass
    try:
        with open(os.path.join(HOME, ".claude", ".credentials.json")) as f:
            return json.load(f).get("claudeAiOauth", {}).get("accessToken")
    except Exception:
        return None


# ---------- usage ----------
def fetch_limits():
    try:
        st = os.stat(LIMITS_CACHE)
        if time.time() - st.st_mtime < LIMITS_TTL:
            with open(LIMITS_CACHE) as f:
                return json.load(f), "cache"
    except Exception:
        pass
    tok = oauth_token()
    if not tok:
        return None, "no-oauth-token"
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": "Bearer " + tok,
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "cc4a",
    })
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        return None, "http-%d" % e.code
    except Exception as e:
        return None, "error-%s" % type(e).__name__
    os.makedirs(CACHE, exist_ok=True)
    tmp = LIMITS_CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, LIMITS_CACHE)
    return data, "live"


def build_usage(sid=None):
    """Prefer the statusline sidecar; fall back to the undocumented endpoint."""
    if sid:
        d, age = read_sidecar(sid)
        rl = (d or {}).get("rate_limits") or {}
        rows = []
        for key, kind in (("five_hour", "session"), ("seven_day", "weekly_all")):
            w = rl.get(key)
            if w and w.get("used_percentage") is not None:
                rows.append({"kind": kind, "scope": None,
                             "used_percentage": w["used_percentage"],
                             "severity": None,
                             "resets_at": datetime.datetime.fromtimestamp(
                                 w["resets_at"], datetime.timezone.utc).isoformat()
                             if w.get("resets_at") else None})
        if rows:
            return {"source": "statusline-sidecar", "age_seconds": age, "limits": rows}

    lim, src = fetch_limits()
    if not lim:
        return {"source": src, "limits": []}
    rows = []
    for e in lim.get("limits", []):
        scope = (e.get("scope") or {}).get("model") or {}
        rows.append({"kind": e.get("kind"), "scope": scope.get("display_name"),
                     "used_percentage": e.get("percent"), "severity": e.get("severity"),
                     "resets_at": e.get("resets_at")})
    return {"source": src, "limits": rows,
            "extra_usage_enabled": bool((lim.get("extra_usage") or {}).get("is_enabled"))}


# ---------- context ----------
def find_transcript(sid):
    hits = glob.glob(os.path.join(HOME, ".claude", "projects", "*", sid + ".jsonl"))
    return hits[0] if hits else None


def window_size_guess():
    for p in (os.path.join(HOME, ".claude", "settings.local.json"),
              os.path.join(HOME, ".claude", "settings.json")):
        try:
            with open(p) as f:
                m = json.load(f).get("model", "")
            if "[1m]" in m:
                return 1_000_000
            if m:
                return 200_000
        except Exception:
            continue
    return 200_000


def last_assistant_record(path, chunk=262144, max_bytes=8 * 1024 * 1024):
    """Last non-sidechain assistant record, read backwards from EOF.

    Transcripts reach tens of megabytes; the record we want is almost always in
    the final few KB, so scanning the whole file to find it is pure waste.
    """
    try:
        size = os.path.getsize(path)
    except OSError:
        return None
    with open(path, "rb") as fh:
        tail, pos = b"", size
        while pos > 0 and size - pos < max_bytes:
            step = min(chunk, pos)
            pos -= step
            fh.seek(pos)
            tail = fh.read(step) + tail
            lines = tail.split(b"\n")
            # the first element may be a partial line unless we reached the start
            start = 0 if pos == 0 else 1
            for raw in reversed(lines[start:]):
                if b'"type":"assistant"' not in raw:
                    continue
                try:
                    d = json.loads(raw.decode("utf-8", "replace"))
                except Exception:
                    continue
                if d.get("type") == "assistant" and not d.get("isSidechain"):
                    return d
    return None


def build_context(sid):
    d, age = read_sidecar(sid)
    cw = (d or {}).get("context_window") or {}
    if cw.get("context_window_size"):
        cu = cw.get("current_usage") or {}
        used = (cu.get("input_tokens", 0) + cu.get("cache_read_input_tokens", 0)
                + cu.get("cache_creation_input_tokens", 0)) or cw.get("total_input_tokens", 0)
        c = {"source": "statusline-sidecar", "used_tokens": used,
             "window_size": cw["context_window_size"],
             "used_percentage": cw.get("used_percentage"),
             "model": (d.get("model") or {}).get("display_name"), "age_seconds": age}
        return finish_context(c)

    path = find_transcript(sid)
    if not path:
        return {"source": "unavailable", "error": "no transcript for session %s" % sid}
    last = last_assistant_record(path)
    if not last:
        return {"source": "unavailable", "error": "no completed assistant turn yet"}
    u = last["message"].get("usage", {})
    used = (u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0)
            + u.get("cache_creation_input_tokens", 0))
    # A session's own window is not recorded anywhere we can read. Above 200k the
    # answer is forced; below it, all we have is this machine's configured model,
    # which is only the right answer for our own session.
    if used > 200_000:
        window, wsrc = 1_000_000, "inferred"
    else:
        window, wsrc = window_size_guess(), "assumed"
    return finish_context({
        "source": "transcript",
        "used_tokens": used,
        "window_size": window,
        "window_source": wsrc,
        "model": last["message"].get("model"),
        "transcript": path,
        "note": "reflects the last completed turn; current turn is not yet written",
    })


def finish_context(c):
    if c.get("used_tokens") and c.get("window_size"):
        if c.get("used_percentage") is None:
            c["used_percentage"] = round(100.0 * c["used_tokens"] / c["window_size"], 1)
        c["remaining_tokens"] = c["window_size"] - c["used_tokens"]
    return c


# ---------- rendering ----------
def bar(pct, width=20):
    pct = max(0.0, min(100.0, float(pct or 0)))
    n = int(round(pct / 100 * width))
    return "[" + "#" * n + "." * (width - n) + "]"


def resets_in(iso):
    if not iso:
        return ""
    try:
        d = datetime.datetime.fromisoformat(iso).timestamp() - time.time()
    except Exception:
        return ""
    return "  resets in %dh%02dm" % (d // 3600, (d % 3600) // 60) if d > 0 else "  resets now"


def human_context(c):
    if not c.get("used_tokens"):
        return "CONTEXT  unavailable (%s)" % c.get("error", "?")
    out = ["CONTEXT  %s %5.1f%%  %s / %s tokens  (%s, via %s)" % (
        bar(c["used_percentage"]), c["used_percentage"], f"{c['used_tokens']:,}",
        f"{c['window_size']:,}", c.get("model") or "?", c["source"])]
    if c.get("note"):
        out.append("         note: " + c["note"])
    return "\n".join(out)


def human_usage(u):
    if not u["limits"]:
        return "USAGE    unavailable (%s)" % u.get("source", "?")
    return "\n".join(
        "%-24s %s %5.1f%%%s" % (
            e["kind"] + (" (%s)" % e["scope"] if e["scope"] else ""),
            bar(e["used_percentage"]), e["used_percentage"], resets_in(e.get("resets_at")))
        for e in u["limits"])


# ---------- wait ----------
def session_status(sid):
    """busy | waiting | idle | None — how Claude Code reports the session's turn."""
    rec = session_record(sid)
    return rec.get("status") if rec.get("sessionId") == sid else None



WINDOW_KIND = {"five_hour": "session", "seven_day": "weekly_all"}

# A condition whose data is missing for one of these reasons will never recover on
# its own; anything else (a 5xx, a dropped connection) may be a blip worth riding out.
PERMANENT_UNAVAILABLE = ("no-oauth-token", "http-401", "http-403", "http-404")


def is_permanent(src):
    return any((src or "").startswith(x) for x in PERMANENT_UNAVAILABLE)


def usage_pct(window):
    u = build_usage(None)
    want = WINDOW_KIND.get(window)
    for row in u["limits"]:
        if row["kind"] == want:
            return row["used_percentage"], u["source"]
    return None, u["source"]


def context_pct(sid):
    c = build_context(sid)
    return c.get("used_percentage"), c.get("source")


def eval_condition(c):
    """Return (met, current_value, detail)."""
    if c["kind"] == "usage":
        val, src = usage_pct(c["window"])
    else:
        val, src = context_pct(c["session"])
    if val is None:
        return None, None, src
    met = val >= c["threshold"] if c["op"] == "above" else val <= c["threshold"]
    return met, val, src


def describe(c):
    if c["kind"] == "usage":
        return "usage[%s] %s %g%%" % (c["window"], c["op"], c["threshold"])
    return "context[%s] %s %g%%" % (c["session"][:8], c["op"], c["threshold"])


def cmd_wait(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print(WAIT_HELP)
        return 0 if argv else 2

    conds, window, sid = [], "five_hour", None
    mode, timeout_s, interval_s, stall_s, unavail_s = "any", None, None, 300, 600
    try:
        for a in argv:
            if a.startswith("--window="):
                window = a.split("=", 1)[1]
                if window not in WINDOW_KIND:
                    raise ValueError("bad --window %r; use five_hour or seven_day" % window)
            elif a.startswith("--session="):
                sid = a.split("=", 1)[1]
            elif a.startswith("--timeout="):
                timeout_s = parse_duration(a.split("=", 1)[1])
            elif a.startswith("--interval="):
                interval_s = parse_duration(a.split("=", 1)[1], 0)
            elif a.startswith("--stall-timeout="):
                stall_s = parse_duration(a.split("=", 1)[1], 0)
            elif a.startswith("--unavailable-timeout="):
                unavail_s = parse_duration(a.split("=", 1)[1], 0)
            elif a == "--all":
                mode = "all"
            elif a == "--any":
                mode = "any"
            elif a.startswith("--usage-") or a.startswith("--context-"):
                name, _, val = a[2:].partition("=")
                kind, _, op = name.partition("-")
                # a condition may name its own target: --context-above=80@<session-id>
                val, _, target = val.partition("@")
                if op not in ("above", "below") or not val:
                    raise ValueError("bad condition %r; use --%s-above=N or --%s-below=N"
                                     % (a, kind, kind))
                conds.append({"kind": kind, "op": op, "target": target or None,
                              "threshold": float(val.rstrip("%"))})
            elif a != "--json":
                raise ValueError("unknown option %r" % a)
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 2

    if not conds:
        print("no conditions given; see `cc4a wait --help`", file=sys.stderr)
        return 2

    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    watching_self = False
    for c in conds:
        if c["kind"] == "usage":
            c["window"] = window
            continue
        c["session"] = c.get("target") or sid or me or ""
        if not c["session"]:
            print("--context-* needs --session=<id>", file=sys.stderr)
            return 2
        if c["session"] == me:
            watching_self = True

    if timeout_s is None:
        timeout_s = 3600
    if interval_s is None:
        interval_s = 60 if any(c["kind"] == "usage" for c in conds) else 5

    if watching_self:
        print("note: watching this session's own context. That only advances when a turn\n"
              "completes, so this must NOT be blocking your turn — start it with\n"
              "run_in_background. If it is blocking, the value is frozen and this exits 4\n"
              "after %s rather than hanging." % fmt_dur(stall_s), file=sys.stderr)

    last_own, stalled_since = None, time.time()
    unavailable_since, warned = {}, set()
    started = time.time()
    print("waiting for %s of: %s  (timeout %s, poll %s)"
          % (mode, ", ".join(describe(c) for c in conds),
             fmt_dur(timeout_s), fmt_dur(interval_s)), file=sys.stderr)

    while True:
        results = [eval_condition(c) for c in conds]
        state = [{"condition": describe(c), "current": v, "met": bool(m), "source": src}
                 for c, (m, v, src) in zip(conds, results)]
        # A condition we cannot evaluate is NOT a condition that is false. Treating
        # "the endpoint is down" as "the limit was never crossed" would make a
        # watchdog silently sleep through the outage it exists to catch.
        for i, (m, v, src) in enumerate(results):
            if m is not None:
                unavailable_since.pop(i, None)
                warned.discard(i)
                continue
            if is_permanent(src):
                print("cannot evaluate %s: %s. This will not recover; not waiting."
                      % (describe(conds[i]), src), file=sys.stderr)
                return 1
            unavailable_since.setdefault(i, time.time())
            if i not in warned:
                warned.add(i)
                print("warning: %s is unavailable (%s) — still polling, will give up "
                      "after %s" % (describe(conds[i]), src, fmt_dur(unavail_s)),
                      file=sys.stderr)
        for i, since in list(unavailable_since.items()):
            dark = time.time() - since
            if dark >= unavail_s:
                out = {"result": "inconclusive", "mode": mode,
                       "waited_seconds": int(time.time() - started),
                       "unavailable": describe(conds[i]), "conditions": state}
                print(json.dumps(out, indent=2) if "--json" in argv else
                      "inconclusive: %s has been unavailable for %s. Its threshold may "
                      "have been crossed unobserved." % (describe(conds[i]), fmt_dur(int(dark))),
                      file=sys.stderr)
                return 5

        met_flags = [m for m, _, _ in results]
        satisfied = (any(met_flags) if mode == "any" else
                     (all(met_flags) and None not in met_flags))
        elapsed = time.time() - started

        if satisfied:
            out = {"result": "met", "mode": mode, "waited_seconds": int(elapsed),
                   "conditions": state}
            print(json.dumps(out, indent=2) if "--json" in argv else
                  "met after %s: %s" % (fmt_dur(int(elapsed)) if elapsed >= 60 else "%ds" % elapsed,
                                        ", ".join("%s (now %.1f%%)" % (s["condition"], s["current"])
                                                  for s in state if s["met"])))
            return 0

        if watching_self:
            own = [s2["current"] for s2, c in zip(state, conds)
                   if c["kind"] == "context" and c.get("session") == me]
            if own and own == last_own:
                stalled_for = time.time() - stalled_since
                if stalled_for >= stall_s and session_status(me) == "busy":
                    print("own context frozen at %s%% for %s while this session is still busy.\n"
                          "This call is blocking your own turn, so the turn cannot complete and\n"
                          "your context cannot advance — the threshold will never arrive.\n"
                          "Re-run with run_in_background, or watch another session."
                          % (own[0], fmt_dur(int(stalled_for))), file=sys.stderr)
                    return 4
            else:
                last_own, stalled_since = own, time.time()

        if elapsed + interval_s > timeout_s:
            out = {"result": "timeout", "mode": mode, "waited_seconds": int(elapsed),
                   "conditions": state}
            print(json.dumps(out, indent=2) if "--json" in argv else
                  "timed out after %s; %s" % (fmt_dur(timeout_s),
                                              ", ".join("%s at %s%%" % (s["condition"], s["current"])
                                                        for s in state)), file=sys.stderr)
            return 3

        time.sleep(interval_s)


