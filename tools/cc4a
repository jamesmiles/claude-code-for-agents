HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".claude", "cache")
LIMITS_CACHE = os.path.join(CACHE, "cc4a-limits.json")
LIMITS_TTL = 60
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"


def sidecar_path(sid):
    return os.path.join(CACHE, "cc4a-statusline-%s.json" % sid)


def read_sidecar(sid, max_age=900):
    try:
        st = os.stat(sidecar_path(sid))
        if time.time() - st.st_mtime > max_age:
            return None, None
        with open(sidecar_path(sid)) as f:
            return json.load(f), int(time.time() - st.st_mtime)
    except Exception:
        return None, None


# ---------- oauth token ----------
def oauth_token():
    if sys.platform == "darwin":
        try:
            raw = subprocess.run(
                ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                capture_output=True, text=True, timeout=5).stdout
            tok = json.loads(raw).get("claudeAiOauth", {}).get("accessToken")
            if tok:
                return tok
        except Exception:
            pass
    try:
        with open(os.path.join(HOME, ".claude", ".credentials.json")) as f:
            return json.load(f).get("claudeAiOauth", {}).get("accessToken")
    except Exception:
        return None


# ---------- usage ----------
def fetch_limits():
    try:
        st = os.stat(LIMITS_CACHE)
        if time.time() - st.st_mtime < LIMITS_TTL:
            with open(LIMITS_CACHE) as f:
                return json.load(f), "cache"
    except Exception:
        pass
    tok = oauth_token()
    if not tok:
        return None, "no-oauth-token"
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": "Bearer " + tok,
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "cc4a",
    })
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        return None, "http-%d" % e.code
    except Exception as e:
        return None, "error-%s" % type(e).__name__
    os.makedirs(CACHE, exist_ok=True)
    tmp = LIMITS_CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, LIMITS_CACHE)
    return data, "live"


def build_usage(sid=None):
    """Prefer the statusline sidecar; fall back to the undocumented endpoint."""
    if sid:
        d, age = read_sidecar(sid)
        rl = (d or {}).get("rate_limits") or {}
        rows = []
        for key, kind in (("five_hour", "session"), ("seven_day", "weekly_all")):
            w = rl.get(key)
            if w and w.get("used_percentage") is not None:
                rows.append({"kind": kind, "scope": None,
                             "used_percentage": w["used_percentage"],
                             "severity": None,
                             "resets_at": datetime.datetime.fromtimestamp(
                                 w["resets_at"], datetime.timezone.utc).isoformat()
                             if w.get("resets_at") else None})
        if rows:
            return {"source": "statusline-sidecar", "age_seconds": age, "limits": rows}

    lim, src = fetch_limits()
    if not lim:
        return {"source": src, "limits": []}
    rows = []
    for e in lim.get("limits", []):
        scope = (e.get("scope") or {}).get("model") or {}
        rows.append({"kind": e.get("kind"), "scope": scope.get("display_name"),
                     "used_percentage": e.get("percent"), "severity": e.get("severity"),
                     "resets_at": e.get("resets_at")})
    return {"source": src, "limits": rows,
            "extra_usage_enabled": bool((lim.get("extra_usage") or {}).get("is_enabled"))}


# ---------- context ----------
def find_transcript(sid):
    hits = glob.glob(os.path.join(HOME, ".claude", "projects", "*", sid + ".jsonl"))
    return hits[0] if hits else None


def window_size_guess():
    for p in (os.path.join(HOME, ".claude", "settings.local.json"),
              os.path.join(HOME, ".claude", "settings.json")):
        try:
            with open(p) as f:
                m = json.load(f).get("model", "")
            if "[1m]" in m:
                return 1_000_000
            if m:
                return 200_000
        except Exception:
            continue
    return 200_000


def build_context(sid):
    d, age = read_sidecar(sid)
    cw = (d or {}).get("context_window") or {}
    if cw.get("context_window_size"):
        cu = cw.get("current_usage") or {}
        used = (cu.get("input_tokens", 0) + cu.get("cache_read_input_tokens", 0)
                + cu.get("cache_creation_input_tokens", 0)) or cw.get("total_input_tokens", 0)
        c = {"source": "statusline-sidecar", "used_tokens": used,
             "window_size": cw["context_window_size"],
             "used_percentage": cw.get("used_percentage"),
             "model": (d.get("model") or {}).get("display_name"), "age_seconds": age}
        return finish_context(c)

    path = find_transcript(sid)
    if not path:
        return {"source": "unavailable", "error": "no transcript for session %s" % sid}
    last = None
    with open(path, errors="replace") as f:
        for line in f:
            if '"type":"assistant"' not in line:
                continue
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("type") == "assistant" and not r.get("isSidechain"):
                last = r
    if not last:
        return {"source": "unavailable", "error": "no completed assistant turn yet"}
    u = last["message"].get("usage", {})
    return finish_context({
        "source": "transcript",
        "used_tokens": (u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0)
                        + u.get("cache_creation_input_tokens", 0)),
        "window_size": window_size_guess(),
        "model": last["message"].get("model"),
        "transcript": path,
        "note": "reflects the last completed turn; current turn is not yet written",
    })


def finish_context(c):
    if c.get("used_tokens") and c.get("window_size"):
        if c.get("used_percentage") is None:
            c["used_percentage"] = round(100.0 * c["used_tokens"] / c["window_size"], 1)
        c["remaining_tokens"] = c["window_size"] - c["used_tokens"]
    return c


# ---------- rendering ----------
def bar(pct, width=20):
    pct = max(0.0, min(100.0, float(pct or 0)))
    n = int(round(pct / 100 * width))
    return "[" + "#" * n + "." * (width - n) + "]"


def resets_in(iso):
    if not iso:
        return ""
    try:
        d = datetime.datetime.fromisoformat(iso).timestamp() - time.time()
    except Exception:
        return ""
    return "  resets in %dh%02dm" % (d // 3600, (d % 3600) // 60) if d > 0 else "  resets now"


def human_context(c):
    if not c.get("used_tokens"):
        return "CONTEXT  unavailable (%s)" % c.get("error", "?")
    out = ["CONTEXT  %s %5.1f%%  %s / %s tokens  (%s, via %s)" % (
        bar(c["used_percentage"]), c["used_percentage"], f"{c['used_tokens']:,}",
        f"{c['window_size']:,}", c.get("model") or "?", c["source"])]
    if c.get("note"):
        out.append("         note: " + c["note"])
    return "\n".join(out)


def human_usage(u):
    if not u["limits"]:
        return "USAGE    unavailable (%s)" % u.get("source", "?")
    return "\n".join(
        "%-24s %s %5.1f%%%s" % (
            e["kind"] + (" (%s)" % e["scope"] if e["scope"] else ""),
            bar(e["used_percentage"]), e["used_percentage"], resets_in(e.get("resets_at")))
        for e in u["limits"])


# ---------- stats ----------
def parse_duration(text, default_seconds=5 * 3600):
    if not text:
        return default_seconds
    units = {"m": 60, "h": 3600, "d": 86400}
    try:
        n, u = int(text[:-1]), text[-1].lower()
        if u in units and n > 0:
            return n * units[u]
    except ValueError:
        pass
    raise ValueError("bad duration %r; use <n>m, <n>h or <n>d" % text)


def iter_usage(cutoff):
    """Yield (record, cwd, timestamp) for assistant messages newer than cutoff."""
    pattern = os.path.join(HOME, ".claude", "projects", "*", "*.jsonl")
    for path in glob.glob(pattern):
        try:
            if os.stat(path).st_mtime < cutoff:
                continue  # a file holding messages after T must be modified after T
        except OSError:
            continue
        cwd = None
        with open(path, errors="replace") as fh:
            for line in fh:
                if '"type":"assistant"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("type") != "assistant":
                    continue
                cwd = cwd or d.get("cwd")
                try:
                    ts = datetime.datetime.fromisoformat(
                        d["timestamp"].replace("Z", "+00:00")).timestamp()
                except Exception:
                    continue
                if ts < cutoff:
                    continue
                yield d, cwd or os.path.basename(os.path.dirname(path)), ts


ZERO = ("output", "cache_write", "input", "cache_read", "messages")


def build_stats(since_s, by="session"):
    if by not in ("session", "project", "model", "day"):
        raise ValueError("bad --by %r; use session, project, model or day" % by)
    cutoff = time.time() - since_s
    groups, sessions = {}, set()
    for d, cwd, ts in iter_usage(cutoff):
        u = d.get("message", {}).get("usage", {})
        sid = d.get("sessionId") or "?"
        sessions.add(sid)
        if by == "session":
            key = sid
        elif by == "project":
            key = os.path.basename(cwd.rstrip("/")) if cwd else "?"
        elif by == "model":
            key = d.get("message", {}).get("model") or "?"
        else:
            key = datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
        g = groups.setdefault(key, dict.fromkeys(ZERO, 0))
        g["output"] += u.get("output_tokens", 0)
        g["cache_write"] += u.get("cache_creation_input_tokens", 0)
        g["input"] += u.get("input_tokens", 0)
        g["cache_read"] += u.get("cache_read_input_tokens", 0)
        g["messages"] += 1
        g["project"] = os.path.basename(cwd.rstrip("/")) if cwd else "?"
        g["last_seen"] = max(g.get("last_seen", 0), ts)

    rows = []
    for key, g in groups.items():
        row = {"key": key}
        row.update({k: g[k] for k in ZERO})
        row["project"] = g.get("project")
        row["last_seen"] = datetime.datetime.fromtimestamp(
            g["last_seen"]).isoformat(timespec="seconds") if g.get("last_seen") else None
        rows.append(row)
    rows.sort(key=lambda r: r["output"], reverse=True)
    totals = {k: sum(r[k] for r in rows) for k in ZERO}
    for r in rows:
        r["output_share_pct"] = round(100.0 * r["output"] / totals["output"], 1) if totals["output"] else 0.0
    return {"since_seconds": since_s, "by": by, "sessions": len(sessions),
            "groups": len(rows), "totals": totals, "rows": rows}


def fmt_dur(s):
    for n, u in ((86400, "d"), (3600, "h"), (60, "m")):
        if s % n == 0 and s >= n:
            return "%d%s" % (s // n, u)
    return "%ds" % s


def human_stats(st, top):
    if not st["rows"]:
        return "no assistant messages in the last %s" % fmt_dur(st["since_seconds"])
    t = st["totals"]
    out = ["last %s: %d sessions, %s messages" % (
        fmt_dur(st["since_seconds"]), st["sessions"], f"{t['messages']:,}"), ""]
    label = {"session": "SESSION", "project": "PROJECT", "model": "MODEL", "day": "DAY"}[st["by"]]
    show = st["rows"][:top]
    keyw = max([len(label)] + [len(r["key"][:8] if st["by"] == "session" else r["key"]) for r in show])
    hdr = "%-*s  %10s %6s  %12s %6s" % (keyw, label, "OUTPUT", "SHARE", "CACHE-WRITE", "MSGS")
    if st["by"] == "session":
        hdr += "  PROJECT"
    out.append(hdr)
    for r in show:
        k = r["key"][:8] if st["by"] == "session" else r["key"]
        line = "%-*s  %10s %5.1f%%  %12s %6s" % (
            keyw, k, f"{r['output']:,}", r["output_share_pct"],
            f"{r['cache_write']:,}", f"{r['messages']:,}")
        if st["by"] == "session":
            line += "  %s" % (r.get("project") or "")
        out.append(line)
    if len(st["rows"]) > top:
        out.append("... %d more (--top=%d, or --json for all)"
                   % (len(st["rows"]) - top, len(st["rows"])))
    out += ["", "totals  output %s · cache-write %s · input %s" % (
        f"{t['output']:,}", f"{t['cache_write']:,}", f"{t['input']:,}"),
        "        cache-read %s — re-counted every turn, not additive consumption"
        % f"{t['cache_read']:,}"]
    return "\n".join(out)


def cmd_stats(argv):
    if "--help" in argv or "-h" in argv:
        print(STATS_HELP)
        return 0
    since, by, top = None, "session", 10
    for a in argv:
        if a.startswith("--since="):
            since = a.split("=", 1)[1]
        elif a.startswith("--by="):
            by = a.split("=", 1)[1]
        elif a.startswith("--top="):
            top = int(a.split("=", 1)[1])
    try:
        st = build_stats(parse_duration(since), by)
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 2
    print(json.dumps(st, indent=2) if "--json" in argv else human_stats(st, top))
    return 0 if st["rows"] else 1


# ---------- status ----------
PROFILE_CACHE = os.path.join(CACHE, "cc4a-profile.json")
PROFILE_TTL = 86400
PROFILE_URL = "https://api.anthropic.com/api/oauth/profile"


def session_record(sid):
    pid = os.environ.get("CLAUDE_PID")
    cands = []
    if pid:
        cands.append(os.path.join(HOME, ".claude", "sessions", "%s.json" % pid))
    cands += sorted(glob.glob(os.path.join(HOME, ".claude", "sessions", "*.json")))
    for c in cands:
        try:
            with open(c) as f:
                d = json.load(f)
        except Exception:
            continue
        if not sid or d.get("sessionId") == sid:
            return d
    return {}


def fetch_profile():
    try:
        st = os.stat(PROFILE_CACHE)
        if time.time() - st.st_mtime < PROFILE_TTL:
            with open(PROFILE_CACHE) as f:
                return json.load(f)
    except Exception:
        pass
    tok = oauth_token()
    if not tok:
        return None
    req = urllib.request.Request(PROFILE_URL, headers={
        "Authorization": "Bearer " + tok,
        "anthropic-beta": "oauth-2025-04-20", "User-Agent": "cc4a"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            data = json.load(r)
    except Exception:
        return None
    os.makedirs(CACHE, exist_ok=True)
    tmp = PROFILE_CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, PROFILE_CACHE)
    return data


def setting_sources():
    out = []
    for label, p in (("user", os.path.join(HOME, ".claude", "settings.json")),
                     ("user (local)", os.path.join(HOME, ".claude", "settings.local.json")),
                     ("project", os.path.join(os.getcwd(), ".claude", "settings.json")),
                     ("project (local)", os.path.join(os.getcwd(), ".claude", "settings.local.json"))):
        if os.path.exists(p):
            out.append(label)
    return out


def configured_mcp():
    names = []
    try:
        with open(os.path.join(HOME, ".claude.json")) as f:
            d = json.load(f)
        names += list((d.get("mcpServers") or {}).keys())
        proj = (d.get("projects") or {}).get(os.getcwd(), {})
        names += list((proj.get("mcpServers") or {}).keys())
    except Exception:
        pass
    return sorted(set(names))


def build_status(sid, local_only=False):
    rec = session_record(sid)
    model = ""
    for p in (os.path.join(HOME, ".claude", "settings.local.json"),
              os.path.join(HOME, ".claude", "settings.json")):
        try:
            with open(p) as f:
                model = json.load(f).get("model") or model
        except Exception:
            pass
        if model:
            break
    ctx = build_context(sid) if sid else {}

    out = {
        "version": rec.get("version"),
        "session_id": sid or rec.get("sessionId"),
        "session_kind": rec.get("kind"),
        "entrypoint": rec.get("entrypoint"),
        "session_name": rec.get("name"),
        "session_name_source": rec.get("nameSource"),
        "started_at": rec.get("procStart"),
        "cwd": os.getcwd(),
        "session_cwd": rec.get("cwd"),
        "peer_address": ("uds:" + rec["messagingSocketPath"]) if rec.get("messagingSocketPath")
                        else os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET"),
        "model": model or None,
        "model_id": ctx.get("model"),
        "effort": os.environ.get("CLAUDE_EFFORT"),
        "setting_sources": setting_sources(),
        "mcp_servers_configured": configured_mcp(),
        "mcp_note": "configured only; live connection state is in-process (see /mcp)",
    }
    if not local_only:
        pr = fetch_profile() or {}
        acct, org = pr.get("account") or {}, pr.get("organization") or {}
        out["account"] = {"name": acct.get("full_name"), "email": acct.get("email"),
                          "plan": "max" if acct.get("has_claude_max")
                                  else "pro" if acct.get("has_claude_pro") else None} if acct else None
        out["organization"] = org.get("name")
    return out


def human_status(s):
    rows = []
    add = lambda k, v: rows.append((k, v)) if v else None
    add("version", s.get("version"))
    sid = s.get("session_id")
    kind = " ".join(x for x in (s.get("session_kind"), s.get("entrypoint")) if x)
    add("session", "%s%s" % (sid, "  (%s)" % kind if kind else "") if sid else None)
    if s.get("session_name"):
        add("name", "%s%s" % (s["session_name"],
                              "  (%s)" % s["session_name_source"] if s.get("session_name_source") else ""))
    add("started", s.get("started_at"))
    add("cwd", s.get("cwd"))
    add("peer", s.get("peer_address"))
    m = s.get("model")
    if m and s.get("model_id") and s["model_id"] not in m:
        m = "%s  (%s)" % (m, s["model_id"])
    add("model", m)
    add("effort", s.get("effort"))
    a = s.get("account") or {}
    if a.get("email"):
        add("account", "%s <%s>%s" % (a.get("name") or "?", a["email"],
                                      "  (%s)" % a["plan"] if a.get("plan") else ""))
    add("organization", s.get("organization"))
    add("settings", ", ".join(s.get("setting_sources") or []))
    mcp = s.get("mcp_servers_configured") or []
    add("mcp", "%d configured: %s" % (len(mcp), ", ".join(mcp)) if mcp else None)
    w = max(len(k) for k, _ in rows) if rows else 0
    lines = ["%-*s  %s" % (w, k, v) for k, v in rows]
    if mcp:
        lines.append("%-*s  %s" % (w, "", s["mcp_note"]))
    return "\n".join(lines)


def cmd_status(argv):
    if "--help" in argv or "-h" in argv:
        print(STATUS_HELP)
        return 0
    s = build_status(session_id(argv), local_only="--local" in argv)
    print(json.dumps(s, indent=2) if "--json" in argv else human_status(s))
    return 0 if s.get("session_id") else 1


# ---------- update ----------
def in_git_clone(path):
    d = os.path.dirname(path)
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def remote_version(text):
    for line in text.splitlines()[:40]:
        if line.startswith("VERSION = "):
            return line.split('"')[1]
    return None


def cmd_update(argv):
    if "--help" in argv or "-h" in argv:
        print(UPDATE_HELP)
        return 0
    ref = "main"
    for a in argv:
        if a.startswith("--ref="):
            ref = a.split("=", 1)[1]
    force = "--force" in argv
    me = os.path.realpath(__file__)

    clone = in_git_clone(me)
    if clone and not force:
        print("cc4a is running from a git clone at %s\n"
              "update with `git -C %s pull`, or pass --force to overwrite the file."
              % (clone, clone), file=sys.stderr)
        return 1

    url = "https://raw.githubusercontent.com/%s/%s/tools/cc4a" % (REPO, ref)
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            text = r.read().decode()
    except Exception as e:
        print("could not download from %s (%s)" % (url, type(e).__name__), file=sys.stderr)
        return 1
    if not text.startswith("#!") or "claude-code-for-agents" not in text:
        print("downloaded payload does not look like cc4a; refusing to install "
              "(bad ref %r?)" % ref, file=sys.stderr)
        return 1

    new = remote_version(text) or "?"
    if new == VERSION and not force:
        print("already up to date (%s)" % VERSION)
        return 0
    if "--check" in argv:
        print("update available: %s -> %s" % (VERSION, new))
        return 0

    d = os.path.dirname(me)
    try:
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".cc4a-")
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, os.stat(me).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        os.replace(tmp, me)
    except OSError as e:
        print("could not write %s (%s)" % (me, e.strerror), file=sys.stderr)
        return 1
    print("updated %s -> %s  (%s)" % (VERSION, new, me))
    return 0


# ---------- commands ----------
def session_id(argv):
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    for a in argv:
        if a.startswith("--session="):
            sid = a.split("=", 1)[1]
    return sid


def cmd_context(argv):
    if "--help" in argv or "-h" in argv:
        print(CONTEXT_HELP)
        return 0
    sid = session_id(argv)
    if not sid:
        print("no session id (set CLAUDE_CODE_SESSION_ID or pass --session=)", file=sys.stderr)
        return 2
    c = build_context(sid)
    print(json.dumps({"session_id": sid, "context": c}, indent=2) if "--json" in argv
          else human_context(c))
    return 0 if c.get("used_tokens") else 1


def cmd_usage(argv):
    if "--help" in argv or "-h" in argv:
        print(USAGE_HELP)
        return 0
    u = build_usage(session_id(argv))
    print(json.dumps(u, indent=2) if "--json" in argv else human_usage(u))
    return 0 if u["limits"] else 1


def cmd_statusline(argv):
    if "--help" in argv or "-h" in argv or sys.stdin.isatty():
        print(STATUSLINE_HELP)
        return 0
    try:
        d = json.load(sys.stdin)
    except Exception:
        return 0
    sid = d.get("session_id")
    if sid:
        os.makedirs(CACHE, exist_ok=True)
        tmp = sidecar_path(sid) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, sidecar_path(sid))
    cw = d.get("context_window") or {}
    rl = d.get("rate_limits") or {}
    parts = [(d.get("model") or {}).get("display_name", "")]
    if cw.get("used_percentage") is not None:
        parts.append("ctx %d%%" % cw["used_percentage"])
    for k, lbl in (("five_hour", "5h"), ("seven_day", "7d")):
        if (rl.get(k) or {}).get("used_percentage") is not None:
            parts.append("%s %d%%" % (lbl, rl[k]["used_percentage"]))
    print(" | ".join(p for p in parts if p))
    return 0


COMMANDS = {"status": cmd_status, "stats": cmd_stats, "context": cmd_context, "usage": cmd_usage,
            "statusline": cmd_statusline, "update": cmd_update}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("--help", "-h", "help"):
        print(ROOT_HELP)
        return 0
    if argv[0] in ("--version", "-V", "version"):
        print("cc4a %s" % VERSION)
        return 0
    if argv[0] not in COMMANDS:
        print("unknown command: %s\n" % argv[0], file=sys.stderr)
        print(ROOT_HELP, file=sys.stderr)
        return 2
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main())
