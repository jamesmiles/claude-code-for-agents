    s = build_status(session_id(argv), local_only="--local" in argv)
    print(json.dumps(s, indent=2) if "--json" in argv else human_status(s))
    return 0 if s.get("session_id") else 1


# ---------- update ----------
def in_git_clone(path):
    d = os.path.dirname(path)
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def remote_version(text):
    for line in text.splitlines()[:40]:
        if line.startswith("VERSION = "):
            return line.split('"')[1]
    return None


def cmd_update(argv):
    if "--help" in argv or "-h" in argv:
        print(UPDATE_HELP)
        return 0
    ref = "main"
    for a in argv:
        if a.startswith("--ref="):
            ref = a.split("=", 1)[1]
    force = "--force" in argv
    me = os.path.realpath(__file__)

    clone = in_git_clone(me)
    if clone and not force:
        print("cc4a is running from a git clone at %s\n"
              "update with `git -C %s pull`, or pass --force to overwrite the file."
              % (clone, clone), file=sys.stderr)
        return 1

    url = "https://raw.githubusercontent.com/%s/%s/tools/cc4a" % (REPO, ref)
    try:
        with urllib.request.urlopen(url, timeout=20) as r:
            text = r.read().decode()
    except Exception as e:
        print("could not download from %s (%s)" % (url, type(e).__name__), file=sys.stderr)
        return 1
    if not text.startswith("#!") or "claude-code-for-agents" not in text:
        print("downloaded payload does not look like cc4a; refusing to install "
              "(bad ref %r?)" % ref, file=sys.stderr)
        return 1

    new = remote_version(text) or "?"
    if new == VERSION and not force:
        print("already up to date (%s)" % VERSION)
        return 0
    if "--check" in argv:
        print("update available: %s -> %s" % (VERSION, new))
        return 0

    d = os.path.dirname(me)
    try:
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".cc4a-")
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, os.stat(me).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        os.replace(tmp, me)
    except OSError as e:
        print("could not write %s (%s)" % (me, e.strerror), file=sys.stderr)
        return 1
    print("updated %s -> %s  (%s)" % (VERSION, new, me))
    return 0


# ---------- commands ----------
def session_id(argv):
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    for a in argv:
        if a.startswith("--session="):
            sid = a.split("=", 1)[1]
    return sid


def cmd_context(argv):
    if "--help" in argv or "-h" in argv:
        print(CONTEXT_HELP)
        return 0
    sid = session_id(argv)
    if not sid:
        print("no session id (set CLAUDE_CODE_SESSION_ID or pass --session=)", file=sys.stderr)
        return 2
    c = build_context(sid)
    print(json.dumps({"session_id": sid, "context": c}, indent=2) if "--json" in argv
          else human_context(c))
    return 0 if c.get("used_tokens") else 1


def cmd_usage(argv):
    if "--help" in argv or "-h" in argv:
        print(USAGE_HELP)
        return 0
    u = build_usage(session_id(argv))
    print(json.dumps(u, indent=2) if "--json" in argv else human_usage(u))
    return 0 if u["limits"] else 1


def cmd_statusline(argv):
    if "--help" in argv or "-h" in argv or sys.stdin.isatty():
        print(STATUSLINE_HELP)
        return 0
    try:
        d = json.load(sys.stdin)
    except Exception:
        return 0
    sid = d.get("session_id")
    if sid:
        os.makedirs(CACHE, exist_ok=True)
        tmp = sidecar_path(sid) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, sidecar_path(sid))
    cw = d.get("context_window") or {}
    rl = d.get("rate_limits") or {}
    parts = [(d.get("model") or {}).get("display_name", "")]
    if cw.get("used_percentage") is not None:
        parts.append("ctx %d%%" % cw["used_percentage"])
    for k, lbl in (("five_hour", "5h"), ("seven_day", "7d")):
        if (rl.get(k) or {}).get("used_percentage") is not None:
            parts.append("%s %d%%" % (lbl, rl[k]["used_percentage"]))
    print(" | ".join(p for p in parts if p))
    return 0


COMMANDS = {"sessions": cmd_sessions, "status": cmd_status, "stats": cmd_stats, "wait": cmd_wait, "context": cmd_context, "usage": cmd_usage,
            "statusline": cmd_statusline, "update": cmd_update}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("--help", "-h", "help"):
        print(ROOT_HELP)
        return 0
    if argv[0] in ("--version", "-V", "version"):
        print("cc4a %s" % VERSION)
        return 0
    if argv[0] not in COMMANDS:
        print("unknown command: %s\n" % argv[0], file=sys.stderr)
        print(ROOT_HELP, file=sys.stderr)
        return 2
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main())
