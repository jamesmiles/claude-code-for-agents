    return 0 if st["rows"] else 1


# ---------- sessions ----------
def live_pids(pids):
    """Which of these pids are running Claude Code right now."""
    if not pids:
        return set()
    try:
        out = subprocess.run(["ps", "-o", "pid=,comm=", "-p", ",".join(str(p) for p in pids)],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return set(pids)  # cannot tell; assume alive rather than hide sessions
    out_pids = set()
    for line in out.strip().splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and "claude" in parts[1]:
            out_pids.add(int(parts[0]))
    return out_pids


def ago(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh%02dm" % (seconds // 3600, (seconds % 3600) // 60)
    return "%dd" % (seconds // 86400)


def build_sessions(active_only=False):
    recs = []
    for f in glob.glob(os.path.join(HOME, ".claude", "sessions", "*.json")):
        try:
            with open(f) as fh:
                recs.append(json.load(fh))
        except Exception:
            continue
    alive = live_pids([r.get("pid") for r in recs if r.get("pid")])

    now, rows = time.time(), []
    for r in recs:
        sid = r.get("sessionId")
        if not sid:
            continue
        path = find_transcript(sid)
        last = os.path.getmtime(path) if path and os.path.exists(path) else None
        ctx = build_context(sid) if path else {}
        rows.append({
            "session_id": sid,
            "pid": r.get("pid"),
            "alive": r.get("pid") in alive,
            "status": r.get("status"),
            "kind": r.get("kind"),
            "entrypoint": r.get("entrypoint"),
            "name": r.get("name"),
            "cwd": r.get("cwd"),
            "version": r.get("version"),
            "started_at": r.get("procStart"),
            "last_active": datetime.datetime.fromtimestamp(last).isoformat(timespec="seconds")
                           if last else None,
            "last_active_seconds_ago": int(now - last) if last else None,
            "transcript": path,
            "transcript_bytes": os.path.getsize(path) if path and os.path.exists(path) else None,
            "context_used_percentage": ctx.get("used_percentage"),
            "context_window_source": ctx.get("window_source"),
            "context_used_tokens": ctx.get("used_tokens"),
            "context_window_size": ctx.get("window_size"),
            "model": ctx.get("model"),
            "is_self": sid == os.environ.get("CLAUDE_CODE_SESSION_ID"),
        })
    if active_only:
        rows = [r for r in rows if r["status"] in ("busy", "waiting")]
    rows.sort(key=lambda r: r["last_active_seconds_ago"] if r["last_active_seconds_ago"]
              is not None else 1 << 40)
    return rows


def human_sessions(rows, top):
    live = [r for r in rows if r["alive"]]
    if not live:
        return "no live Claude sessions found"
    show = live[:top]
    namew = max([4] + [len(r["name"] or "") for r in show])
    out = ["%d live sessions" % len(live), "",
           "%-8s %-8s %7s %6s  %-*s  %s" % ("STATUS", "SESSION", "CONTEXT", "LAST", namew, "NAME", "CWD")]
    for r in show:
        pct = ("%s%.1f%%" % ("~" if r.get("context_window_source") == "assumed" else "",
                             r["context_used_percentage"])
               if r["context_used_percentage"] is not None else "-")
        last = ago(r["last_active_seconds_ago"]) if r["last_active_seconds_ago"] is not None else "-"
        cwd = (r["cwd"] or "").replace(HOME, "~")
        out.append("%-8s %-8s %7s %6s  %-*s  %s%s" % (
            r["status"] or "?", r["session_id"][:8], pct, last, namew, r["name"] or "", cwd,
            "   <- this session" if r["is_self"] else ""))
    if len(live) > top:
        out.append("... %d more (--top=%d, or --json for all)" % (len(live) - top, len(live)))
    return "\n".join(out)


def cmd_sessions(argv):
    if "--help" in argv or "-h" in argv:
        print(SESSIONS_HELP)
        return 0
    top = 20
    for a in argv:
        if a.startswith("--top="):
            top = int(a.split("=", 1)[1])
    rows = build_sessions(active_only="--active" in argv)
    if "--json" in argv:
        print(json.dumps({"sessions": rows}, indent=2))
    else:
        print(human_sessions(rows, top))
    return 0 if any(r["alive"] for r in rows) else 1


